# PostgreSQL
POSTGRES_USER=vgsolar
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=vgsolar

# HTTP authentication
JWT_SECRET=replace-with-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_ACTIVE_SESSIONS_PER_USER=5
SESSION_RETENTION_DAYS=30

# Bootstrap account
API_BOOTSTRAP_EMAIL=admin@example.com
API_BOOTSTRAP_PASSWORD=replace-with-strong-bootstrap-password

# Public service address
PUBLIC_HOST=your-server-ip-or-domain

# Map service
MAP_PUBLIC_BASE_URL=http://your-server-ip-or-domain
MAP_UPLOAD_TOKEN=replace-with-random-map-upload-token
